# Docker Compose — variables d'environnement (copier vers .env et adapter)

# PostgreSQL
POSTGRES_DB=microsolu
POSTGRES_USER=microsolu
POSTGRES_PASSWORD=microsolu_secret
POSTGRES_PORT=5432

# Backend (port Nginx exposé)
BACKEND_PORT=8000

# Frontend (port Next.js exposé en prod)
FRONTEND_PORT=3000

# Le frontend appelle l'API backend via cette URL
NEXT_PUBLIC_API_URL=http://localhost:8000
